<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>BusinessTime.Tests</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BusinessTime.Core\BusinessTime.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The wizard assembly is WPF and cannot be loaded on a build agent that is not Windows, but the time
      zone list it shows is ordinary code. Compiling that one file in here puts it under test anyway.
    -->
    <Compile Include="..\..\src\BusinessTime.Activities.Wizard\TimeZoneChoice.cs" Link="Wizard\TimeZoneChoice.cs" />
  </ItemGroup>

</Project>
