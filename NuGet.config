<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      UiPath's official public feed. The workflow runtime has to come from here: the UiPath.Workflow builds
      published to nuget.org carry a System.Activities whose assembly version no Studio ships, so an activity
      compiled against one of those asks the host for a version it does not have.
    -->
    <add key="uipath-official" value="https://pkgs.dev.azure.com/uipath/Public.Feeds/_packaging/UiPath-Official/nuget/v3/index.json" />
  </packageSources>
</configuration>
