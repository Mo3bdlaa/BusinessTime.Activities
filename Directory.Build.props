<Project>

  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Mohammed Shaker</Authors>
    <Company>Mohammed Shaker</Company>
    <Product>Shaker BusinessTime Activities</Product>
    <Copyright>Copyright (c) Mohammed Shaker</Copyright>
    <PackageProjectUrl>https://github.com/Mo3bdlaa/Shaker.BusinessTime.Activities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mo3bdlaa/Shaker.BusinessTime.Activities</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

</Project>
