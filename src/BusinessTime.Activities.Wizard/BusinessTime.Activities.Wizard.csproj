<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Design time only, and Windows only, like any Studio UI. It targets net6.0-windows rather than net461
      because modern Studio runs on .NET 8 and never loads the .NET Framework assets; EnableWindowsTargeting
      lets the whole solution still build on a machine that is not Windows.
    -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>BusinessTime.Activities.Wizard</RootNamespace>
    <AssemblyName>BusinessTime.Activities.Wizard</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessTime.Core\BusinessTime.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Studio supplies both of these at run time, so neither travels in the package. -->
    <PackageReference Include="UiPath.Activities.Api" Version="24.10.1" PrivateAssets="all" />
    <PackageReference Include="UiPath.Workflow" Version="6.0.0-20240401-07" PrivateAssets="all" />
  </ItemGroup>

</Project>
