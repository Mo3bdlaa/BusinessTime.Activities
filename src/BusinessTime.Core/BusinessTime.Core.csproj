<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net461;net6.0</TargetFrameworks>
    <RootNamespace>BusinessTime</RootNamespace>
    <AssemblyName>BusinessTime.Core</AssemblyName>
    <PackageId>BusinessTime.Core</PackageId>
    <Description>Calendar-aware business time engine: weekly working schedules, holidays, shift overrides and time-zone aware arithmetic over working hours.</Description>
    <PackageTags>business-days;working-hours;calendar;sla;datetime</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
