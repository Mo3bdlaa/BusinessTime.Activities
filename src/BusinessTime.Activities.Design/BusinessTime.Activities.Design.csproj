<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Design time only. Studio is a Windows WPF application, so this assembly is Windows-only by nature
      however the runtime is targeted; the activities themselves stay cross-platform. The UI is built in
      code rather than XAML, because the WPF markup compiler only runs on Windows and this project has to
      build anywhere the rest of the solution does.
    -->
    <TargetFramework>net461</TargetFramework>
    <RootNamespace>BusinessTime.Activities.Design</RootNamespace>
    <AssemblyName>BusinessTime.Activities.Design</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessTime.Activities\BusinessTime.Activities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Activities" />
    <Reference Include="System.Activities.Presentation" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
