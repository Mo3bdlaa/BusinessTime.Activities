<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;net6.0</TargetFrameworks>
    <RootNamespace>BusinessTime.Activities</RootNamespace>
    <AssemblyName>BusinessTime.Activities</AssemblyName>
    <PackageId>Shaker.BusinessTime.Activities</PackageId>
    <Title>Business Time Activities</Title>
    <Description>UiPath activities for working-hours arithmetic: add and subtract business days and hours, measure business time between two moments, and describe a working week, its holidays and its exceptions in one shared calendar.</Description>
    <PackageTags>UiPath;RPA;activities;business-days;working-hours;calendar;sla</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReleaseNotes>Working-hours arithmetic for UiPath: add and subtract business days and hours, measure business time between two moments, and maintain one shared calendar of the working week, its holidays, half days and shutdowns — from the activities or from the Business Calendar editor in Studio's ribbon.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessTime.Core\BusinessTime.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Activities" />
    <Reference Include="System.ComponentModel.Composition" />
    <!--
      The embedded engine reads calendar files with System.Text.Json. .NET 6 carries it in the shared
      framework, but a Windows-legacy project has to be told to bring it along.
    -->
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <!--
      Compile time only: Studio and the Robot bring their own workflow runtime, and PrivateAssets keeps this
      out of the package's dependencies so none of it lands in the consuming project.

      The version matters more than it looks. This must be a build UiPath actually ships, from their official
      feed, because the assembly version of System.Activities is what the activities are compiled to ask the
      host for. The UiPath.Workflow packages on nuget.org carry System.Activities 6.0.3.0, which no Studio
      has; the runtime resolves assemblies forward but never backward, so a project on the shipped 6.0.0.0
      fails to load them with "Could not load file or assembly 'System.Activities, Version=6.0.3.0'".
    -->
    <PackageReference Include="UiPath.Workflow" Version="6.0.0-20240401-07" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Shown beside the package in Studio's package manager and on the Marketplace listing. -->
    <None Include="package-icon.png" Pack="true" PackagePath="\" />
    <!--
      The ribbon icon travels as a file beside the wizard assembly, not only embedded in it: naming it by
      path is the one way to reach it that does not ask WPF to resolve this assembly by name, which Studio's
      load context defeats.
    -->
    <None Include="..\BusinessTime.Activities.Wizard\Resources\calendar.png" Pack="true" PackagePath="lib\net6.0" />
  </ItemGroup>

  <!--
    The engine travels inside this package rather than as a separate dependency, so that installing one
    .nupkg into Studio or Orchestrator is enough to get a working activity pack.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBusinessTimeCore;IncludeBusinessTimeDesigners;IncludeBusinessTimeWizard</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeBusinessTimeCore">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)BusinessTime.Core.dll" />
      <BuildOutputInPackage Include="$(OutputPath)BusinessTime.Core.xml" Condition="Exists('$(OutputPath)BusinessTime.Core.xml')" />
    </ItemGroup>
  </Target>

  <!--
    Studio loads the designers from an assembly sitting beside the activities. It is design time only and
    Windows only, so it ships with the net461 assets and is simply absent from the cross-platform ones,
    where the stock designers apply. It is referenced by path rather than as a ProjectReference because the
    design project references this one, and NuGet will not allow that circle.
  -->
  <PropertyGroup>
    <DesignAssembly>$(MSBuildThisFileDirectory)..\BusinessTime.Activities.Design\bin\$(Configuration)\net461\BusinessTime.Activities.Design.dll</DesignAssembly>
    <ModernDesignAssembly>$(MSBuildThisFileDirectory)..\BusinessTime.Activities.Design\bin\$(Configuration)\net6.0-windows\BusinessTime.Activities.Design.dll</ModernDesignAssembly>
  </PropertyGroup>

  <!--
    The ribbon wizard is design time only and Windows only, but modern Studio runs on .NET 8 and never
    loads the .NET Framework assets, so it travels with the net6.0 ones instead.
  -->
  <PropertyGroup>
    <WizardAssembly>$(MSBuildThisFileDirectory)..\BusinessTime.Activities.Wizard\bin\$(Configuration)\net6.0-windows\BusinessTime.Activities.Wizard.dll</WizardAssembly>
  </PropertyGroup>

  <Target Name="IncludeBusinessTimeWizard" Condition="'$(TargetFramework)' == 'net6.0'">
    <Warning Condition="!Exists('$(WizardAssembly)')"
             Text="BusinessTime.Activities.Wizard.dll was not found at $(WizardAssembly), so this package will ship without the calendar wizard. Build the solution before packing." />
    <Warning Condition="!Exists('$(ModernDesignAssembly)')"
             Text="The .NET build of BusinessTime.Activities.Design.dll was not found at $(ModernDesignAssembly), so a modern Studio will show the stock designers. Build the solution before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="$(WizardAssembly)" Condition="Exists('$(WizardAssembly)')" />
      <BuildOutputInPackage Include="$(ModernDesignAssembly)" Condition="Exists('$(ModernDesignAssembly)')" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeBusinessTimeDesigners" Condition="'$(TargetFramework)' == 'net461'">
    <Warning Condition="!Exists('$(DesignAssembly)')"
             Text="BusinessTime.Activities.Design.dll was not found at $(DesignAssembly), so this package will ship without designers. Build the solution before packing." />
    <ItemGroup>
      <BuildOutputInPackage Include="$(DesignAssembly)" Condition="Exists('$(DesignAssembly)')" />
    </ItemGroup>
  </Target>

</Project>
